 {
  "id": "S4",
  "question": "Q04",
  "tier": "public",
  "needs": "statement",
  "scope": "The product publishes an interface that other agents can call: a published MCP server, an A2A agent card, or an API documented for agent use. Checked by a read-only fetch of the interface or its description, or on a vendor documentation page. An interface the product only consumes (it calls other MCP servers) does not count.",
  "text": "It exposes an agent interface: a published MCP server, an agent card, or an API documented for agents to call",
  "spectrum": true,
  "links": [
   {
    "provision": "mcp.01",
    "relation": "part",
    "basis": "The requirement applies to MCP servers; a product that publishes one is a subject of it. Publishing the server is not evidence that the metadata is implemented.",
    "asserted_by": "gamma-ray@web-summit.dinis",
    "asserted_at": "2026-11-10",
    "strength": "weak: one reader, unchecked"
   },
   {
    "provision": "owasp.AT6",
    "relation": "part",
    "basis": "The type is an agent that connects to external tools and services across trust boundaries; an interface published for other agents is the other end of such a connection.",
