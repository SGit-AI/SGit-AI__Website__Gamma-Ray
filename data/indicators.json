 {
  "id": "S1",
  "question": "Q02",
  "tier": "public",
  "needs": "statement",
  "scope": "A public source has to name a customer, or give usage figures, for the capability that acts: sessions, tasks or pull requests, not install or seat counts. A demonstration or a roadmap does not count. Since Spectrum 0.2 this fact earns the In production badge; it is no longer part of an Autonomy level.",
  "text": "It is in production: a public source names a customer or gives usage figures for what it does on its own",
  "spectrum": true,
  "links": [
   {
    "provision": "nist.MAP-1.4",
    "relation": "part",
    "basis": "The subcategory asks that the business value of use be defined; a named customer in production is public evidence of one such use.",
    "asserted_by": "gamma-ray@web-summit.dinis",
    "asserted_at": "2026-11-10",
    "strength": "weak: one reader, unchecked"
   },
   {
    "provision": "ms.400.2.3",
    "relation": "part",
    "basis": "The item asks for measurable business value from agents; published usage figures are a measure of use, though not of value.",
    "asserted_by": "gamma-ray@web-summit.dinis",
    "asserted_at": "2026-11-10",
    "strength": "weak: one reader, unchecked"
   },
   {
    "provision": "sf.a06",
    "relation": "part",
    "basis": "The step asks to demonstrate early efficiency metrics; a case study with figures does that for one customer.",
    "asserted_by": "gamma-ray@web-summit.dinis",
    "asserted_at": "2026-11-10",
    "strength": "weak: one reader, unchecked"
   }
  ]
 },
